<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  coverage — module KHÔNG SINH MÃ. Nó chỉ gộp báo cáo độ phủ và áp ngưỡng.
  ============================================================================

  VÌ SAO NGƯỠNG PHẢI NẰM Ở ĐÂY CHỨ KHÔNG Ở TỪNG MODULE.

  Bản một khối có đúng một bundle JaCoCo, nên `jacoco:check` áp thẳng lên nó là
  hợp lý. Tách thành mười module thì mỗi module có bundle riêng, và áp cùng một
  ngưỡng 68 % cho từng cái sẽ đỏ ngay lập tức:

      libs/core          ~75 %   nhiều test đơn vị    ✓
      search-service     ~60 %   phần lớn là wiring   ✗ đỏ
      api-gateway        ~10 %   toàn cấu hình        ✗ đỏ
      settings-service   ~55 %   CRUD mỏng            ✗ đỏ

  Ba module đỏ đó KHÔNG có nghĩa là chất lượng giảm — độ phủ toàn hệ thống vẫn
  là 71 %. Và cách sửa dễ nhất khi build đỏ luôn là hạ ngưỡng, hoặc tệ hơn, đặt
  ngưỡng riêng cho từng module rồi hạ dần từng cái. Lúc đó cổng chặn thành đồ
  trang trí.

  Gộp lại rồi kiểm MỘT LẦN trên tổng giữ đúng ý nghĩa mà ngưỡng vốn có ở bản
  một khối: nó đo cùng một tập mã, bằng cùng một con số.

  VÌ SAO MODULE NÀY PHẢI ĐỨNG CUỐI TRONG <modules>. Nó đọc tệp jacoco.exec của
  mọi module khác. Maven dựng module theo thứ tự khai báo (sau khi giải phụ
  thuộc), nên đặt nó ở giữa danh sách nghĩa là nó gộp một tập báo cáo thiếu —
  và ra một con số cao giả tạo, vì những module chưa chạy test không đóng góp
  dòng nào vào mẫu số.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.vnsearch</groupId>
		<artifactId>vnsearch-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>coverage</artifactId>
	<name>coverage</name>
	<description>Gộp báo cáo độ phủ của toàn reactor và áp ngưỡng một lần trên tổng</description>

	<properties>
		<!-- Không có mã nguồn thì không có gì để phân tích tĩnh. Không tắt thì
		     SpotBugs báo lỗi vì không tìm thấy thư mục class. -->
		<spotbugs.skip>true</spotbugs.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<!--
	  Phụ thuộc vào MỌI module có mã nguồn.
	  Không phải để dùng lớp nào cả — `report-aggregate` chỉ gộp báo cáo của
	  những module nằm trong danh sách phụ thuộc của module chạy nó. Thiếu một
	  dòng ở đây thì module đó biến mất khỏi báo cáo tổng, âm thầm, và con số
	  cuối cùng nói sai sự thật.
	-->
	<dependencies>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>vnsearch-core-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>vnsearch-core-crawler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>vnsearch-core-search</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>vnsearch-platform</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>api-gateway</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>auth-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>search-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>crawler-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.vnsearch</groupId>
			<artifactId>analytics-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- history/downloads/settings/football: viết lại bằng Go (backend/go),
		     độ phủ đo bằng `go test` trong job CI riêng. -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<!--
					  POM cha gắn `prepare-agent` cho MỌI module, kể cả module
					  này. Ở đây nó vô nghĩa (không có test nào chạy) và còn có
					  hại: nó đặt lại property `argLine`. Tắt đi.
					-->
					<execution>
						<id>chuan-bi-agent</id>
						<phase>none</phase>
					</execution>
					<execution>
						<id>sinh-bao-cao</id>
						<phase>none</phase>
					</execution>

					<!--
					  GỘP mọi tệp .exec thành một.

					  `report-aggregate` tự gộp được, nhưng `check` thì KHÔNG:
					  goal đó chỉ đọc đúng một tệp dữ liệu. Nên phải gộp tay
					  trước, rồi trỏ `check` vào tệp đã gộp.
					-->
					<execution>
						<id>gop-du-lieu</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.basedir}/..</directory>
									<includes>
										<include>**/target/jacoco.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-tong.exec</destFile>
						</configuration>
					</execution>

					<!-- Báo cáo HTML/XML đọc được, cho CI tải lên làm artifact. -->
					<execution>
						<id>bao-cao-tong</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/site/jacoco-aggregate
							</outputDirectory>
						</configuration>
					</execution>

					<!-- CỔNG CHẶN. Đây là lý do module này tồn tại. -->
					<execution>
						<id>kiem-tra-nguong-toan-cuc</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-tong.exec</dataFile>
							<!-- Cùng danh sách loại trừ với bản một khối: đây là
							     các CÔNG CỤ DÒNG LỆNH có hàm main(), chạy tay khi
							     cần sinh báo cáo hoặc nhập dữ liệu. Viết test cho
							     chúng là test cho System.out.println, và chúng
							     không nằm trên đường chạy của request nào. -->
							<excludes>
								<exclude>com/vnsearch/eval/EvaluationRunner.*</exclude>
								<exclude>com/vnsearch/eval/QrelsEvaluationRunner.*</exclude>
								<exclude>com/vnsearch/eval/TokenizerBenchmark.*</exclude>
								<exclude>com/vnsearch/eval/MemoryBreakdown.*</exclude>
								<exclude>com/vnsearch/eval/PoolBuilder.*</exclude>
								<exclude>com/vnsearch/storage/GinBaselineRunner.*</exclude>
								<exclude>com/vnsearch/storage/PostgresImportRunner.*</exclude>
								<exclude>com/vnsearch/crawler/MultiDomainCrawlRunner.*</exclude>
								<exclude>com/vnsearch/crawler/ProgressBarCrawlListener.*</exclude>
								<exclude>com/vnsearch/crawler/ConsoleCrawlListener.*</exclude>
								<!-- Mười lớp khởi động Spring: chỉ có main() gọi
								     SpringApplication.run. -->
								<exclude>com/vnsearch/*ServiceApplication.*</exclude>
								<exclude>com/vnsearch/gateway/ApiGatewayApplication.*</exclude>
								<!-- Lớp sinh tự động từ XSD (contract-first SOAP).
								     Chúng là mã của trình sinh, không phải mã của
								     dự án — và đưa chúng vào mẫu số sẽ làm con số
								     độ phủ tăng hoặc giảm theo kích thước lược đồ
								     XML, tức là mất hết ý nghĩa. -->
								<exclude>com/vnsearch/soap/generated/**</exclude>
							</excludes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.branch.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
