<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  VnSearch — POM CHA của reactor đa module.
  ============================================================================

  TỆP NÀY TỪNG LÀ POM CỦA MỘT KHỐI DUY NHẤT. Toàn bộ backend — crawler, chỉ
  mục, xếp hạng, xác thực, phân tích — nằm chung một tiến trình, một cổng
  8080, một tệp jar. Nay nó được tách thành nhiều tiến trình chạy độc lập,
  đứng sau một API Gateway.

  VÌ SAO GIỮ NGUYÊN THƯ MỤC `search-engine/`. Ba nơi trỏ vào đúng đường dẫn
  này: `.github/workflows/ci.yml` (`working-directory: search-engine`),
  `codeql.yml`, và `release.yml`. Biến POM này thành POM aggregator thay vì
  dời cây thư mục nghĩa là `./mvnw -B clean verify` vẫn dựng và kiểm thử TOÀN
  BỘ hệ thống bằng đúng câu lệnh cũ — không một dòng workflow nào phải sửa.
  Một cuộc tái cấu trúc bắt CI phải sửa theo là một cuộc tái cấu trúc sẽ có
  người quên sửa.

  BẢN ĐỒ MODULE
  ─────────────────────────────────────────────────────────────────────────
    core              thư viện — toàn bộ cấu trúc dữ liệu và thuật toán tự
                      cài (Trie, BloomFilter, LRUCache, MinHeap,
                      InvertedIndex, PageRank, crawler, kho tài liệu).
                      KHÔNG có tầng web, KHÔNG khởi động Spring.
    platform          thư viện — hạ tầng web dùng chung: CORS, xử lý lỗi
                      toàn cục, giới hạn tần suất, lọc khoá API, và bộ lọc
                      nhận danh tính do Gateway truyền xuống.

    gateway           :8080  API Gateway (Spring Cloud Gateway)
    auth-service      :8081  tài khoản, phiên, quản trị người dùng
    search-service    :8082  truy vấn, gợi ý, ảnh, bảng tin
    crawler-service   :8083  điều khiển crawl, tiêu thụ Kafka
    analytics-service :8084  thu và đọc số liệu sử dụng
    history-service   :8085  lịch sử duyệt web và lịch sử tìm kiếm
    downloads-service :8086  sổ tải xuống
    settings-service  :8087  tuỳ chọn người dùng, đồng bộ giữa máy

    coverage          KHÔNG sinh mã — chỉ gộp báo cáo JaCoCo của mọi module
                      rồi áp ngưỡng độ phủ trên TỔNG. Xem chú thích trong
                      coverage/pom.xml về lý do ngưỡng phải đặt ở đó.

  VÌ SAO CÓ `core` THAY VÌ MỖI SERVICE MỘT BẢN SAO THUẬT TOÁN. Đồ thị phụ
  thuộc giữa các gói thuật toán có chu trình thật sự (`storage` ↔ `index`,
  `model` ↔ `crawler`): chúng là MỘT khối tri thức, không phải nhiều khối
  ghép lại. Cắt chúng ra sẽ phải viết lại chứ không phải dời đi, và viết lại
  hai mươi nghìn dòng thuật toán đã có kiểm thử để đạt một sơ đồ đẹp hơn là
  đánh đổi tồi. Ranh giới microservice ở đây nằm ở TIẾN TRÌNH và HỢP ĐỒNG
  HTTP — mỗi service khởi động riêng, hỏng riêng, giãn riêng, triển khai
  riêng — còn thư viện thuật toán thì dùng chung, đúng như cách mọi hệ thống
  thật dùng chung một thư viện nội bộ.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.vnsearch</groupId>
	<artifactId>vnsearch-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>vnsearch-parent</name>
	<description>VnSearch — reactor cha cho các microservice và thư viện dùng chung</description>

	<modules>
		<module>libs/core</module>
		<module>libs/platform</module>
		<module>services/api-gateway</module>
		<module>services/auth-service</module>
		<module>services/search-service</module>
		<module>services/crawler-service</module>
		<module>services/analytics-service</module>
		<module>services/history-service</module>
		<module>services/downloads-service</module>
		<module>services/settings-service</module>
		
		
		
		
		
		
		
		
		<!-- PHẢI đứng cuối: nó đọc tệp jacoco.exec của mọi module đứng trước. -->
		<module>coverage</module>
	</modules>

	<properties>
		<java.version>17</java.version>

		<!-- Nâng jackson-bom lên trên mức Spring Boot 3.5.16 quản lý (2.21.4).
		     Bản đó dính CVE-2026-59889, CVE-2026-54515 và GHSA-mhm7-754m-9p8w —
		     cổng quét ảnh Docker trong CI chặn merge vì chúng. Đây là phép đè
		     TẠM: bỏ dòng này khi Spring Boot quản lý 2.21.5 trở lên. -->
		<jackson-bom.version>2.21.5</jackson-bom.version>

		<!-- Spring Cloud, chỉ dùng cho module `gateway`. Bản 2025.1.x đi cùng
		     Spring Boot 3.5.x; lệch dòng này là lỗi khởi động chứ không phải
		     lỗi biên dịch, nên nó ghim ở đây một lần cho cả reactor. -->
		<spring-cloud.version>2025.1.0</spring-cloud.version>

		<!-- Ngưỡng độ phủ kiểm thử, áp trên TỔNG của mọi module (xem
		     coverage/pom.xml). Đo được trên cây mã hiện tại:
		         LINE = 71,0 %      BRANCH = 69,1 %
		     Ngưỡng đặt thấp hơn vài điểm để một hàm mới chưa kịp có test không
		     làm đỏ bản build ngay lập tức. Nâng lên mỗi khi độ phủ thật tăng;
		     đừng bao giờ hạ xuống để build xanh trở lại — hạ ngưỡng là bỏ cổng
		     chặn, không phải sửa lỗi. -->
		<jacoco.line.minimum>0.68</jacoco.line.minimum>
		<jacoco.branch.minimum>0.65</jacoco.branch.minimum>

		<!-- Tệp loại trừ của SpotBugs nằm ở gốc reactor (cạnh POM này).
		     ============================================================
		     Ba cách viết đường dẫn, hai cách sai:

		       ${project.basedir}/../     đúng cho MODULE CON, sai cho chính
		                                  POM cha — nó trỏ ra ngoài thư mục
		                                  reactor, và bản build đổ ngay ở
		                                  module đầu tiên với
		                                  "Could not find resource".
		       ${session.executionRootDirectory}
		                                  phụ thuộc vào thư mục người ta đứng
		                                  khi gõ lệnh. Chạy `mvn -f
		                                  search-engine/pom.xml` từ gốc kho là
		                                  ra một giá trị khác.
		       ${maven.multiModuleProjectDirectory}   (chọn)
		                                  Maven tự đặt bằng thư mục chứa `.mvn/`
		                                  — tức đúng `search-engine/`, giống
		                                  nhau ở mọi module và không đổi theo
		                                  chỗ gõ lệnh. -->
		<spotbugs.exclude.file>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</spotbugs.exclude.file>

		<!-- Nhóm test bị LOẠI trong lần chạy thường ngày.
		     ============================================================
		     Phải là một PROPERTY chứ không phải giá trị viết thẳng vào
		     cấu hình surefire. Lý do là một hành vi của Maven đã làm mất
		     nguyên một cổng chặn ở đây:

		     Cấu hình plugin trong một <profile> được HỢP NHẤT với cấu hình
		     ở <build>, không thay thế nó. Một thẻ rỗng
		     `<excludedGroups></excludedGroups>` trong profile KHÔNG xoá
		     được giá trị của lớp dưới — Maven giữ nguyên `kafka-it`.

		     Kết quả: `mvnw verify -Pkafka-it` có cả
		         <groups>kafka-it</groups>          (chỉ chạy nhóm này)
		         <excludedGroups>kafka-it</excludedGroups>  (loại nhóm này)
		     Loại trừ thắng, nên nó chạy 0 bài test và in BUILD SUCCESS.

		     Property thì ghi đè được, vì profile đặt lại chính property đó. -->
		<test.excluded.groups>kafka-it,docker-it</test.excluded.groups>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Hai module nội bộ, khai báo phiên bản một lần ở đây để các
			     module con chỉ cần groupId + artifactId. -->
			<dependency>
				<groupId>com.vnsearch</groupId>
				<artifactId>vnsearch-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.vnsearch</groupId>
				<artifactId>vnsearch-platform</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Nimbus JOSE+JWT: ký và phân tích JWT/JWKS ở auth-service.
			     KHÔNG nằm trong BOM của Spring Boot (BOM chỉ quản lý
			     oauth2-oidc-sdk), nên phải ghim phiên bản ở đây. Con số này
			     PHẢI khớp với phiên bản mà spring-security-oauth2-jose kéo
			     theo — lệch nhau thì hai bản cùng nằm trên classpath và lớp
			     nào thắng là do thứ tự classpath quyết định. Kiểm tra bằng:
			         ./mvnw dependency:tree -pl auth-service | grep nimbus -->
			<dependency>
				<groupId>com.nimbusds</groupId>
				<artifactId>nimbus-jose-jwt</artifactId>
				<version>9.37.4</version>
			</dependency>

			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.23.1</version>
			</dependency>
			<dependency>
				<groupId>net.logstash.logback</groupId>
				<artifactId>logstash-logback-encoder</artifactId>
				<version>8.0</version>
			</dependency>
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>42.7.12</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!--
	  Phụ thuộc mà MỌI module đều dùng. Cố tình rất ngắn: mỗi thứ thêm vào đây
	  là một thứ mà cả mười module phải tải, phải quét CVE, và phải chịu khi nó
	  vỡ. Những thứ chỉ vài module cần (web, security, kafka, jdbc) khai báo ở
	  chính module cần chúng.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- LOẠI test tích hợp Kafka khỏi lần chạy thường ngày.
						     ============================================================
						     Các bài gắn @Tag("kafka-it") dựng một broker THẬT bằng
						     Testcontainers: khoảng 15 giây khởi động, và cần Docker
						     đang chạy trên máy.

						     Bắt mọi lập trình viên trả cái giá đó cho MỖI lần
						     `mvnw test` là cách chắc chắn nhất khiến họ ngừng chạy
						     test — và một bộ test không được chạy là một bộ test
						     không tồn tại (chính lập luận mở đầu ci.yml).

						     Chạy chúng bằng:   ./mvnw verify -Pkafka-it -->
						<excludedGroups>${test.excluded.groups}</excludedGroups>
						<systemPropertyVariables>
							<!-- Khoá GIẢ. SecurityConfig cố ý không cho ứng dụng khởi
							     động khi thiếu khoá, nên mọi bài test dùng
							     @SpringBootTest đều cần một khoá. Đủ 16 ký tự để qua
							     phép kiểm tra độ dài.
							     KHÔNG BAO GIỜ dùng giá trị này ở môi trường thật. -->
							<ADMIN_API_KEY>test-only-key-0123456789abcdef</ADMIN_API_KEY>

							<!-- Bí mật nội bộ giả, dùng cho các bài test dựng nguyên
							     một service và tự đóng vai Gateway. Xem
							     platform/.../GatewayIdentityFilter. -->
							<GATEWAY_SHARED_SECRET>test-only-gateway-secret-0123456789</GATEWAY_SHARED_SECRET>

							<!-- Tắt giới hạn tần suất: các bài test dùng chung một gáo
							     token, nên khi bộ test lớn dần chúng sẽ bắt đầu nhận
							     429 thay vì kết quả thật — đúng loại lỗi chập chờn
							     tốn nhiều giờ nhất để truy. -->
							<app.security.rate-limit.enabled>false</app.security.rate-limit.enabled>

							<!-- Thư mục `data/` của reactor, đường dẫn TUYỆT ĐỐI.
							     ============================================================
							     Trong bản một khối, mọi bài test chạy với thư mục làm việc là
							     `search-engine/`, nên `data/seed-documents.json` giải đúng.
							     Với reactor đa module, surefire chạy mỗi module trong thư mục
							     CỦA MODULE ĐÓ — `backend/libs/core/` — và đường dẫn tương đối
							     ấy trỏ vào hư không.

							     Hai cách sửa, một cách sai: đặt `workingDirectory` của surefire
							     về gốc reactor sẽ chữa được bài này nhưng LÀM HỎNG những bài
							     khác đang trỏ tới `src/test/resources/fixtures/...` của chính
							     module chúng. Một property mang đường dẫn tuyệt đối thì không
							     động tới bài nào khác. -->
							<vnsearch.data.dir>${maven.multiModuleProjectDirectory}/data</vnsearch.data.dir>
						</systemPropertyVariables>
					</configuration>
				</plugin>

				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>4.8.6.4</version>
					<configuration>
						<!-- `threshold=Medium` chứ không phải `Low`: mức Low sinh rất
						     nhiều cảnh báo về phong cách, và một danh sách quá dài thì
						     không ai đọc — đó là cách nhanh nhất để biến phân tích
						     tĩnh thành thứ bị phớt lờ. -->
						<effort>Max</effort>
						<threshold>Medium</threshold>
						<includeTests>false</includeTests>
						<excludeFilterFile>${spotbugs.exclude.file}</excludeFilterFile>
						<!-- Xuất thêm SARIF để tải lên tab Security của GitHub: cảnh
						     báo hiện ngay trong pull request thay vì nằm trong một tệp
						     XML mà không ai mở. -->
						<sarifOutput>true</sarifOutput>
					</configuration>
					<executions>
						<execution>
							<id>kiem-tra-tinh</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.5.0</version>
					<configuration>
						<classpathScope>compile</classpathScope>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>0.8.12</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- CHỈ gắn agent và sinh báo cáo cho từng module.
			     PHÉP KIỂM NGƯỠNG cố tình KHÔNG nằm ở đây — nó nằm ở module
			     `coverage`, áp một lần trên tổng. Nếu kiểm theo từng module thì
			     một module thư viện mỏng có 40 % độ phủ sẽ làm đỏ bản build dù
			     độ phủ toàn hệ thống vẫn là 71 %, và cách sửa dễ nhất lúc đó
			     luôn là hạ ngưỡng — tức là giết cổng chặn. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>chuan-bi-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>sinh-bao-cao</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Hồ sơ CHỈ để chạy test tích hợp Kafka.

		     ./mvnw verify -Pkafka-it

		     Nó đảo ngược đúng một thứ: thay vì LOẠI nhóm `kafka-it`, nó chỉ
		     chạy nhóm đó. Nhờ vậy job CI tương ứng mất khoảng một phút thay vì
		     chạy lại toàn bộ bộ test đã chạy ở job chính.

		     Hai cổng chặn nặng (JaCoCo, SpotBugs) cũng được tắt ở đây: chúng đã
		     chạy ở job chính, và độ phủ đo trên MỘT nhóm test nhỏ thì chắc chắn
		     dưới ngưỡng — bật lên chỉ tạo một bản build đỏ vô nghĩa. -->
		<profile>
			<id>docker-it</id>
			<properties>
				<jacoco.skip>true</jacoco.skip>
				<spotbugs.skip>true</spotbugs.skip>
				<test.excluded.groups></test.excluded.groups>
			</properties>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-surefire-plugin</artifactId>
							<configuration>
								<groups>docker-it</groups>
								<includes>
									<include>**/*IT.java</include>
								</includes>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>

		<profile>
			<id>kafka-it</id>
			<properties>
				<jacoco.skip>true</jacoco.skip>
				<spotbugs.skip>true</spotbugs.skip>
				<!-- Rỗng: bỏ hẳn phần loại trừ, để <groups> bên dưới quyết
				     định. Ghi đè được vì đây là property — xem giải thích ở
				     khối <properties> đầu tệp. -->
				<test.excluded.groups></test.excluded.groups>
			</properties>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-surefire-plugin</artifactId>
							<configuration>
								<groups>kafka-it</groups>

								<!-- BẮT BUỘC. Mẫu tên mặc định của surefire là
								     `*Test.java`, `Test*.java`, `*Tests.java`,
								     `*TestCase.java` — hậu tố `IT` KHÔNG nằm trong đó
								     (nó thuộc về failsafe, một plugin khác).

								     Thiếu khối này thì KafkaCrawlBusIT không bao giờ
								     được nạp, và lệnh `mvnw verify -Pkafka-it` in ra:

								         Tests run: 0, Failures: 0, Errors: 0
								         BUILD SUCCESS

								     Đây là lỗi đã xảy ra thật khi viết tệp này. Nó
								     nguy hiểm hơn một bản build đỏ: một cổng chặn
								     luôn xanh vì không kiểm gì cả trông y hệt một
								     cổng chặn đang hoạt động tốt. -->
								<includes>
									<include>**/*IT.java</include>
								</includes>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
