<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  vnsearch-core — THƯ VIỆN thuật toán. Không phải một service.
  ============================================================================

  Đây là phần NỘI DUNG CHÍNH của đồ án: Trie, BloomFilter, LRUCache, MinHeap,
  chỉ mục đảo, PageRank, bộ tách từ tiếng Việt, crawler, kho tài liệu. Mọi thứ
  ở đây đều tự cài đặt.

  BA RÀNG BUỘC CỦA MODULE NÀY, và lý do:

  1. KHÔNG có `spring-boot-maven-plugin`. Nó phải sinh ra một jar THƯỜNG, vì
     jar do plugin đó đóng gói lại (executable jar) không dùng làm phụ thuộc
     được — lớp nằm trong `BOOT-INF/classes`, không nằm ở gốc.

  2. KHÔNG có `spring-boot-starter-web`. Không một lớp nào ở đây được biết
     tới HTTP. Ngày mà một `@RestController` lọt vào module này là ngày ranh
     giới microservice bắt đầu tan.

  3. CÓ `spring-context` và `spring-kafka`. Vài lớp (SearchEngineFacade,
     CrawlJobManager, ScorerFactory) dùng `@Value` và `@Service` để nhận cấu
     hình. Đó là cái giá đã trả từ trước; gỡ ra sẽ phải viết lại hàm khởi tạo
     của chúng và của mọi bài test đang gọi. Bù lại, service nào nạp bean nào
     thì do `scanBasePackages` của service đó quyết định — xem Javadoc lớp
     khởi động của từng service.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.vnsearch</groupId>
		<artifactId>vnsearch-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>vnsearch-core</artifactId>
	<name>vnsearch-core</name>
	<description>Cấu trúc dữ liệu, thuật toán, crawler và kho tài liệu — dùng chung cho mọi service</description>

	<dependencies>
		<!-- `spring-boot-starter` TRẦN, không phải `-web`: nó mang DI, @Value,
		     autoconfigure và SLF4J/Logback — vừa đủ để các lớp ở đây nhận cấu
		     hình và ghi log — mà KHÔNG kéo theo Tomcat và Spring MVC. Đó chính
		     là ranh giới muốn giữ: thư viện này không được biết tới HTTP. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<!-- Đọc/ghi JSON cho kho tài liệu và cho các thông điệp trên bus. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- Đo lường. KHÔNG phải registry Prometheus — chỉ phần API
		     (MeterRegistry, Counter, Gauge) mà crawler và bus dùng để đếm.
		     Việc chọn đẩy số liệu đi đâu là của service, không phải của thư
		     viện: một thư viện tự quyết định registry là một thư viện không
		     nhúng được vào tiến trình đã có registry riêng. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>

		<!-- Bóc HTML khi crawl. -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>

		<!-- Driver PostgreSQL. Cố ý KHÔNG dùng spring-boot-starter-jdbc/JPA:
		     kho tài liệu được truy cập bằng JDBC thuần qua DocumentRepository,
		     nên ứng dụng Spring vẫn khởi động bình thường khi không có CSDL
		     (quan trọng cho test và cho demo nhanh), đồng thời câu lệnh SQL
		     hiện rõ trong mã nguồn để đưa vào báo cáo. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!-- Bus sự kiện giữa crawler và các Modular Service (Analytics, Image
		     Download, URL Extractor).

		     VÌ SAO KAFKA CHỨ KHÔNG PHẢI MỘT HÀNG ĐỢI CÔNG VIỆC. Ba service đó
		     KHÔNG chia nhau một khối lượng công việc — mỗi service muốn đọc
		     TOÀN BỘ luồng trang, chỉ khác nhau ở việc nó làm gì với trang ấy.
		     Đó là phát tán một-tới-nhiều, và trong Kafka nó miễn phí: mỗi
		     service là một consumer group riêng, giữ offset riêng trên cùng
		     một topic. Với một hàng đợi công việc (RabbitMQ) thì mỗi thông
		     điệp chỉ đến đúng một consumer, nên phải nhân bản thông điệp ra ba
		     hàng đợi và tự giữ cho chúng đồng bộ.

		     Hệ quả thứ hai, quan trọng không kém: thêm một service thứ tư
		     KHÔNG phải sửa crawler. Nó chỉ cần một group.id mới.

		     VÌ SAO KHÔNG THAY URL FRONTIER BẰNG KAFKA. Frontier phải hoãn theo
		     host (politeness) và sắp theo mức ưu tiên. Một topic Kafka trả
		     thông điệp theo đúng thứ tự ghi trong mỗi phân hoạch và không có
		     khái niệm "khoan, hãy đưa cái này cho tôi sau một giây nữa". Xem
		     docs/Math/10-kafka/00-SO-DO-TU-DUY.md. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- Test tích hợp Kafka: dựng broker thật trong Docker.
		     KHÔNG chạy trong `mvnw test` thường ngày — xem hồ sơ `kafka-it`
		     trong POM cha. Một broker thật mất khoảng 15 giây để khởi động, và
		     bắt mọi lập trình viên trả cái giá đó cho mỗi lần chạy test là
		     cách chắc chắn nhất khiến họ ngừng chạy test. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Chạy các runner độc lập (crawl đa domain, bộ đánh giá IR) từ CLI:
			     ./mvnw -pl core exec:java -Dexec.mainClass=... -Dexec.args="..." -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
