<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.vnsearch</groupId>
	<artifactId>search-engine</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>search-engine</name>
	<description>DSA search engine backend (self-implemented data structures and algorithms)</description>

	<properties>
		<java.version>17</java.version>

		<!-- Ngưỡng độ phủ kiểm thử.
		     Đo được trên cây mã hiện tại (sau các loại trừ ở jacoco-maven-plugin):
		         LINE   = 71,0 %      BRANCH = 69,1 %
		     Ngưỡng đặt thấp hơn vài điểm để một hàm mới chưa kịp có test không
		     làm đỏ bản build ngay lập tức. Nâng lên mỗi khi độ phủ thật tăng;
		     đừng bao giờ hạ xuống để build xanh trở lại — hạ ngưỡng là bỏ cổng
		     chặn, không phải sửa lỗi. -->
		<!-- Nang jackson-bom len tren muc Spring Boot 3.5.16 quan ly (2.21.4).
		     Ban do dinh CVE-2026-59889, CVE-2026-54515 va GHSA-mhm7-754m-9p8w —
		     cong quet anh Docker trong CI chan merge vi chung. Day la phep de
		     TAM: bo dong nay khi Spring Boot quan ly 2.21.5 tro len. -->
		<jackson-bom.version>2.21.5</jackson-bom.version>

		<jacoco.line.minimum>0.68</jacoco.line.minimum>
		<jacoco.branch.minimum>0.65</jacoco.branch.minimum>

		<!-- KHÔNG còn phải đè phiên bản Testcontainers.
		     ============================================================
		     Ghi lại vì bài học vẫn còn giá trị. Spring Boot 3.3.4 quản lý
		     Testcontainers 1.19.8, và bản đó đi kèm docker-java 3.3.6 — một
		     client nói phiên bản Docker API mà Engine 29.x không còn nhận.
		     Triệu chứng rất dễ dẫn sai đường:

		         docker version          -> 29.6.1, hoàn toàn bình thường
		         Testcontainers          -> "Could not find a valid Docker
		                                     environment"

		     Thực chất daemon TRẢ LỜI, nhưng trả HTTP 400 kèm một khối Info
		     rỗng, và Testcontainers dịch điều đó thành "không tìm thấy
		     Docker". Đọc thông báo lỗi theo nghĩa đen sẽ đi tìm sai chỗ —
		     biến môi trường, tên pipe, quyền truy cập — trong khi nguyên
		     nhân là lệch phiên bản API.

		     Chỗ này từng có <testcontainers.version>1.21.4</testcontainers.version>
		     để vá. Spring Boot 3.5.16 nay quản lý ĐÚNG 1.21.4, nên phép đè
		     thành thừa — và một phép đè thừa là một phép đè sẽ GHIM phiên bản
		     lại khi BOM tiến lên. Bỏ đi thì Spring Boot tự lo. -->

		<!-- Nhóm test bị LOẠI trong lần chạy thường ngày.
		     ============================================================
		     Phải là một PROPERTY chứ không phải giá trị viết thẳng vào
		     cấu hình surefire. Lý do là một hành vi của Maven đã làm mất
		     nguyên một cổng chặn ở đây:

		     Cấu hình plugin trong một <profile> được HỢP NHẤT với cấu hình
		     ở <build>, không thay thế nó. Một thẻ rỗng
		     `<excludedGroups></excludedGroups>` trong profile KHÔNG xoá
		     được giá trị của lớp dưới — Maven giữ nguyên `kafka-it`.

		     Kết quả: `mvnw verify -Pkafka-it` có cả
		         <groups>kafka-it</groups>          (chỉ chạy nhóm này)
		         <excludedGroups>kafka-it</excludedGroups>  (loại nhóm này)
		     Loại trừ thắng, nên nó chạy 0 bài test và in BUILD SUCCESS.

		     Property thì ghi đè được, vì profile đặt lại chính property đó. -->
		<test.excluded.groups>kafka-it</test.excluded.groups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.23.1</version>
		</dependency>

		<!-- Bao ve /api/admin/**. Chi dung phan loc + cau hinh chuoi loc; KHONG
		     dung phan quan ly nguoi dung, vi he thong nay chi co MOT chu the goi
		     la cong cu van hanh, khong co nguoi dung dang nhap. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Kiem tra rang buoc tham so ngay o bien controller (@Valid, @Max...)
		     thay vi rai if-throw trong than ham. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Quan sat duoc: /actuator/health, /actuator/metrics, /actuator/prometheus -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Log dang JSON cho profile prod (xem logback-spring.xml). Log dang van
		     xuoi khong truy van duoc: mot su co luc 3 gio sang can loc theo
		     truong, khong phai doc bang mat. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>

		<!-- Driver PostgreSQL. Co y KHONG dung spring-boot-starter-jdbc/JPA:
		     kho tai lieu duoc truy cap bang JDBC thuan qua DocumentRepository,
		     nen ung dung Spring van khoi dong binh thuong khi khong co CSDL
		     (quan trong cho test va cho demo nhanh), dong thoi cau lenh SQL
		     hien ro trong ma nguon de dua vao bao cao. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.12</version>
		</dependency>

		<!-- Bus sự kiện giữa crawler và các Modular Service (Analytics, Image
		     Download, URL Extractor).

		     VÌ SAO KAFKA CHỨ KHÔNG PHẢI MỘT HÀNG ĐỢI CÔNG VIỆC. Ba service đó
		     KHÔNG chia nhau một khối lượng công việc — mỗi service muốn đọc
		     TOÀN BỘ luồng trang, chỉ khác nhau ở việc nó làm gì với trang ấy.
		     Đó là phát tán một-tới-nhiều, và trong Kafka nó miễn phí: mỗi
		     service là một consumer group riêng, giữ offset riêng trên cùng
		     một topic. Với một hàng đợi công việc (RabbitMQ) thì mỗi thông
		     điệp chỉ đến đúng một consumer, nên phải nhân bản thông điệp ra ba
		     hàng đợi và tự giữ cho chúng đồng bộ.

		     Hệ quả thứ hai, quan trọng không kém: thêm một service thứ tư
		     KHÔNG phải sửa crawler. Nó chỉ cần một group.id mới.

		     VÌ SAO KHÔNG THAY URL FRONTIER BẰNG KAFKA. Frontier phải hoãn theo
		     host (politeness) và sắp theo mức ưu tiên. Một topic Kafka trả
		     thông điệp theo đúng thứ tự ghi trong mỗi phân hoạch và không có
		     khái niệm "khoan, hãy đưa cái này cho tôi sau một giây nữa". Xem
		     docs/Math/10-kafka/00-SO-DO-TU-DUY.md. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Test tích hợp Kafka: dựng broker thật trong Docker.
		     KHÔNG chạy trong `mvnw test` thường ngày — xem hồ sơ `kafka-it` ở
		     dưới. Một broker thật mất khoảng 15 giây để khởi động, và bắt mọi
		     lập trình viên trả cái giá đó cho mỗi lần chạy test là cách chắc
		     chắn nhất khiến họ ngừng chạy test. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Cap cau hinh chi danh cho luc CHAY TEST.

			     Vi sao dat o day chu khong phai src/test/resources/application.properties:
			     tep do se CHE HAN tep cung ten trong src/main/resources (Spring chi
			     lay tep dau tien tim thay tren classpath, khong hop nhat hai tep),
			     nen moi khoa khong duoc chep lai deu bien mat. Da thu, va hau qua la
			     CorsConfig khong tim thay app.cors.allowed-origins.

			     Dat o day thi cau hinh that van la nguon su that duy nhat; cho nay
			     chi them dung hai gia tri ma test can. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- LOẠI test tích hợp Kafka khỏi lần chạy thường ngày.
					     ============================================================
					     Các bài gắn @Tag("kafka-it") dựng một broker THẬT bằng
					     Testcontainers: khoảng 15 giây khởi động, và cần Docker
					     đang chạy trên máy.

					     Bắt mọi lập trình viên trả cái giá đó cho MỖI lần
					     `mvnw test` là cách chắc chắn nhất khiến họ ngừng chạy
					     test — và một bộ test không được chạy là một bộ test
					     không tồn tại (chính lập luận mở đầu ci.yml).

					     Chạy chúng bằng:   ./mvnw verify -Pkafka-it
					     CI chạy chúng ở một job riêng, song song với job chính.

					     Giá trị đến từ property `test.excluded.groups` — xem
					     phần <properties> để biết vì sao KHÔNG viết thẳng. -->
					<excludedGroups>${test.excluded.groups}</excludedGroups>
					<systemPropertyVariables>
						<!-- Khoa GIA. SecurityConfig co y khong cho ung dung khoi dong
						     khi thieu khoa, nen moi bai test dung @SpringBootTest deu
						     can mot khoa. Du 16 ky tu de qua phep kiem tra do dai.
						     KHONG BAO GIO dung gia tri nay o moi truong that. -->
						<ADMIN_API_KEY>test-only-key-0123456789abcdef</ADMIN_API_KEY>

						<!-- Tat gioi han tan suat: cac bai test dung chung mot gao
						     token, nen khi bo test lon dan chung se bat dau nhan 429
						     thay vi ket qua that — dung loai loi chap chon ton nhieu
						     gio nhat de truy. -->
						<app.security.rate-limit.enabled>false</app.security.rate-limit.enabled>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- ĐO ĐỘ PHỦ KIỂM THỬ, và CHẶN nếu tụt dưới ngưỡng.
			     ============================================================
			     Vì sao cần một ngưỡng chứ không chỉ một báo cáo: một con số chỉ
			     để nhìn thì sẽ tụt dần mà không ai nhận ra. Ngưỡng biến nó thành
			     một điều kiện phải giữ.

			     Vì sao ngưỡng đặt ở mức này chứ không phải 80%: đây là con số ĐO
			     ĐƯỢC trên cây mã hiện tại, làm tròn xuống. Đặt một ngưỡng cao hơn
			     thực tế thì bản build đỏ ngay từ ngày đầu và việc đầu tiên người
			     ta làm là hạ nó xuống — lúc đó cổng chặn thành đồ trang trí. Cách
			     dùng đúng: mỗi lần độ phủ tăng thật thì nâng ngưỡng lên theo.

			     Vì sao loại trừ các lớp dưới đây: chúng là CÔNG CỤ DÒNG LỆNH có
			     hàm main(), chạy tay khi cần sinh báo cáo hoặc nhập dữ liệu. Viết
			     test cho chúng là test cho System.out.println. Chúng không nằm
			     trên đường chạy của một request nào. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<!-- Runner đánh giá IR + công cụ đo, chỉ chạy tay từ CLI -->
						<exclude>com/vnsearch/eval/EvaluationRunner.*</exclude>
						<exclude>com/vnsearch/eval/QrelsEvaluationRunner.*</exclude>
						<exclude>com/vnsearch/eval/TokenizerBenchmark.*</exclude>
						<exclude>com/vnsearch/eval/MemoryBreakdown.*</exclude>
						<exclude>com/vnsearch/eval/PoolBuilder.*</exclude>
						<!-- Công cụ nhập liệu / thí nghiệm đối chứng PostgreSQL -->
						<exclude>com/vnsearch/storage/GinBaselineRunner.*</exclude>
						<exclude>com/vnsearch/storage/PostgresImportRunner.*</exclude>
						<!-- Runner crawl đa domain + hai bộ hiển thị tiến độ ra console -->
						<exclude>com/vnsearch/crawler/MultiDomainCrawlRunner.*</exclude>
						<exclude>com/vnsearch/crawler/ProgressBarCrawlListener.*</exclude>
						<exclude>com/vnsearch/crawler/ConsoleCrawlListener.*</exclude>
						<!-- Lớp khởi động Spring: chỉ có main() gọi SpringApplication.run -->
						<exclude>com/vnsearch/VnSearchApplication.*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>chuan-bi-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>sinh-bao-cao</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>kiem-tra-nguong</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.branch.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- PHÂN TÍCH TĨNH — tìm lỗi mà trình biên dịch không thấy và test
			     không chạy tới: so sánh chuỗi bằng ==, luồng có thể null, tài
			     nguyên không đóng, đồng bộ hoá sai.
			     ============================================================
			     `threshold=Medium` chứ không phải `Low`: mức Low sinh rất nhiều
			     cảnh báo về phong cách, và một danh sách quá dài thì không ai
			     đọc — đó là cách nhanh nhất để biến phân tích tĩnh thành thứ bị
			     phớt lờ.

			     Gắn vào pha `verify` để `mvn verify` chạy nó, còn `mvn test`
			     (vòng lặp thường ngày của lập trình viên) vẫn nhanh. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.6.4</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<includeTests>false</includeTests>
					<excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
					<!-- Xuất thêm SARIF để tải lên tab Security của GitHub: cảnh
					     báo hiện ngay trong pull request thay vì nằm trong một
					     tệp XML mà không ai mở. -->
					<sarifOutput>true</sarifOutput>
				</configuration>
				<executions>
					<execution>
						<id>kiem-tra-tinh</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Chay cac runner doc lap (crawl da domain, bo danh gia IR) tu CLI:
			     mvnw exec:java -Dexec.mainClass=... -Dexec.args="..." -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<classpathScope>compile</classpathScope>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Hồ sơ CHỈ để chạy test tích hợp Kafka.

		     ./mvnw verify -Pkafka-it

		     Nó đảo ngược đúng một thứ: thay vì LOẠI nhóm `kafka-it`, nó chỉ
		     chạy nhóm đó. Nhờ vậy job CI tương ứng mất khoảng một phút thay vì
		     chạy lại toàn bộ 482 bài test đã chạy ở job chính.

		     Hai cổng chặn nặng (JaCoCo, SpotBugs) cũng được tắt ở đây: chúng đã
		     chạy ở job chính, và độ phủ đo trên MỘT nhóm test nhỏ thì chắc chắn
		     dưới ngưỡng — bật lên chỉ tạo một bản build đỏ vô nghĩa. -->
		<profile>
			<id>kafka-it</id>
			<properties>
				<jacoco.skip>true</jacoco.skip>
				<spotbugs.skip>true</spotbugs.skip>
				<!-- Rỗng: bỏ hẳn phần loại trừ, để <groups> bên dưới quyết
				     định. Ghi đè được vì đây là property — xem giải thích ở
				     khối <properties> đầu tệp. -->
				<test.excluded.groups></test.excluded.groups>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<groups>kafka-it</groups>

							<!-- BẮT BUỘC. Mẫu tên mặc định của surefire là
							     `*Test.java`, `Test*.java`, `*Tests.java`,
							     `*TestCase.java` — hậu tố `IT` KHÔNG nằm trong đó
							     (nó thuộc về failsafe, một plugin khác).

							     Thiếu khối này thì KafkaCrawlBusIT không bao giờ
							     được nạp, và lệnh `mvnw verify -Pkafka-it` in ra:

							         Tests run: 0, Failures: 0, Errors: 0
							         BUILD SUCCESS

							     Đây là lỗi đã xảy ra thật khi viết tệp này. Nó
							     nguy hiểm hơn một bản build đỏ: một cổng chặn
							     luôn xanh vì không kiểm gì cả trông y hệt một
							     cổng chặn đang hoạt động tốt. -->
							<includes>
								<include>**/*IT.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
