<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
		<relativePath/>
	</parent>
	<groupId>com.vnsearch</groupId>
	<artifactId>search-engine</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>search-engine</name>
	<description>DSA search engine backend (self-implemented data structures and algorithms)</description>

	<properties>
		<java.version>17</java.version>

		<!-- Ngưỡng độ phủ kiểm thử.
		     Đo được trên cây mã hiện tại (sau các loại trừ ở jacoco-maven-plugin):
		         LINE   = 71,0 %      BRANCH = 69,1 %
		     Ngưỡng đặt thấp hơn vài điểm để một hàm mới chưa kịp có test không
		     làm đỏ bản build ngay lập tức. Nâng lên mỗi khi độ phủ thật tăng;
		     đừng bao giờ hạ xuống để build xanh trở lại — hạ ngưỡng là bỏ cổng
		     chặn, không phải sửa lỗi. -->
		<jacoco.line.minimum>0.68</jacoco.line.minimum>
		<jacoco.branch.minimum>0.65</jacoco.branch.minimum>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.18.1</version>
		</dependency>

		<!-- Bao ve /api/admin/**. Chi dung phan loc + cau hinh chuoi loc; KHONG
		     dung phan quan ly nguoi dung, vi he thong nay chi co MOT chu the goi
		     la cong cu van hanh, khong co nguoi dung dang nhap. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Kiem tra rang buoc tham so ngay o bien controller (@Valid, @Max...)
		     thay vi rai if-throw trong than ham. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Quan sat duoc: /actuator/health, /actuator/metrics, /actuator/prometheus -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Log dang JSON cho profile prod (xem logback-spring.xml). Log dang van
		     xuoi khong truy van duoc: mot su co luc 3 gio sang can loc theo
		     truong, khong phai doc bang mat. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>

		<!-- Driver PostgreSQL. Co y KHONG dung spring-boot-starter-jdbc/JPA:
		     kho tai lieu duoc truy cap bang JDBC thuan qua DocumentRepository,
		     nen ung dung Spring van khoi dong binh thuong khi khong co CSDL
		     (quan trong cho test va cho demo nhanh), dong thoi cau lenh SQL
		     hien ro trong ma nguon de dua vao bao cao. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.4</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Cap cau hinh chi danh cho luc CHAY TEST.

			     Vi sao dat o day chu khong phai src/test/resources/application.properties:
			     tep do se CHE HAN tep cung ten trong src/main/resources (Spring chi
			     lay tep dau tien tim thay tren classpath, khong hop nhat hai tep),
			     nen moi khoa khong duoc chep lai deu bien mat. Da thu, va hau qua la
			     CorsConfig khong tim thay app.cors.allowed-origins.

			     Dat o day thi cau hinh that van la nguon su that duy nhat; cho nay
			     chi them dung hai gia tri ma test can. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<!-- Khoa GIA. SecurityConfig co y khong cho ung dung khoi dong
						     khi thieu khoa, nen moi bai test dung @SpringBootTest deu
						     can mot khoa. Du 16 ky tu de qua phep kiem tra do dai.
						     KHONG BAO GIO dung gia tri nay o moi truong that. -->
						<ADMIN_API_KEY>test-only-key-0123456789abcdef</ADMIN_API_KEY>

						<!-- Tat gioi han tan suat: cac bai test dung chung mot gao
						     token, nen khi bo test lon dan chung se bat dau nhan 429
						     thay vi ket qua that — dung loai loi chap chon ton nhieu
						     gio nhat de truy. -->
						<app.security.rate-limit.enabled>false</app.security.rate-limit.enabled>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- ĐO ĐỘ PHỦ KIỂM THỬ, và CHẶN nếu tụt dưới ngưỡng.
			     ============================================================
			     Vì sao cần một ngưỡng chứ không chỉ một báo cáo: một con số chỉ
			     để nhìn thì sẽ tụt dần mà không ai nhận ra. Ngưỡng biến nó thành
			     một điều kiện phải giữ.

			     Vì sao ngưỡng đặt ở mức này chứ không phải 80%: đây là con số ĐO
			     ĐƯỢC trên cây mã hiện tại, làm tròn xuống. Đặt một ngưỡng cao hơn
			     thực tế thì bản build đỏ ngay từ ngày đầu và việc đầu tiên người
			     ta làm là hạ nó xuống — lúc đó cổng chặn thành đồ trang trí. Cách
			     dùng đúng: mỗi lần độ phủ tăng thật thì nâng ngưỡng lên theo.

			     Vì sao loại trừ các lớp dưới đây: chúng là CÔNG CỤ DÒNG LỆNH có
			     hàm main(), chạy tay khi cần sinh báo cáo hoặc nhập dữ liệu. Viết
			     test cho chúng là test cho System.out.println. Chúng không nằm
			     trên đường chạy của một request nào. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<!-- Runner đánh giá IR + công cụ đo, chỉ chạy tay từ CLI -->
						<exclude>com/vnsearch/eval/EvaluationRunner.*</exclude>
						<exclude>com/vnsearch/eval/QrelsEvaluationRunner.*</exclude>
						<exclude>com/vnsearch/eval/TokenizerBenchmark.*</exclude>
						<exclude>com/vnsearch/eval/MemoryBreakdown.*</exclude>
						<exclude>com/vnsearch/eval/PoolBuilder.*</exclude>
						<!-- Công cụ nhập liệu / thí nghiệm đối chứng PostgreSQL -->
						<exclude>com/vnsearch/storage/GinBaselineRunner.*</exclude>
						<exclude>com/vnsearch/storage/PostgresImportRunner.*</exclude>
						<!-- Runner crawl đa domain + hai bộ hiển thị tiến độ ra console -->
						<exclude>com/vnsearch/crawler/MultiDomainCrawlRunner.*</exclude>
						<exclude>com/vnsearch/crawler/ProgressBarCrawlListener.*</exclude>
						<exclude>com/vnsearch/crawler/ConsoleCrawlListener.*</exclude>
						<!-- Lớp khởi động Spring: chỉ có main() gọi SpringApplication.run -->
						<exclude>com/vnsearch/VnSearchApplication.*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>chuan-bi-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>sinh-bao-cao</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>kiem-tra-nguong</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.branch.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- PHÂN TÍCH TĨNH — tìm lỗi mà trình biên dịch không thấy và test
			     không chạy tới: so sánh chuỗi bằng ==, luồng có thể null, tài
			     nguyên không đóng, đồng bộ hoá sai.
			     ============================================================
			     `threshold=Medium` chứ không phải `Low`: mức Low sinh rất nhiều
			     cảnh báo về phong cách, và một danh sách quá dài thì không ai
			     đọc — đó là cách nhanh nhất để biến phân tích tĩnh thành thứ bị
			     phớt lờ.

			     Gắn vào pha `verify` để `mvn verify` chạy nó, còn `mvn test`
			     (vòng lặp thường ngày của lập trình viên) vẫn nhanh. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.6.4</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<includeTests>false</includeTests>
					<excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
					<!-- Xuất thêm SARIF để tải lên tab Security của GitHub: cảnh
					     báo hiện ngay trong pull request thay vì nằm trong một
					     tệp XML mà không ai mở. -->
					<sarifOutput>true</sarifOutput>
				</configuration>
				<executions>
					<execution>
						<id>kiem-tra-tinh</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Chay cac runner doc lap (crawl da domain, bo danh gia IR) tu CLI:
			     mvnw exec:java -Dexec.mainClass=... -Dexec.args="..." -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<classpathScope>compile</classpathScope>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
